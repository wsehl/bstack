{
  "name": "bstack",
  "version": "0.0.0",
  "description": "Create native GitHub stacked pull requests from a linear series of commits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsehl/bstack.git"
  },
  "files": [
    "bin",
    "src"
  ],
  "bin": {
    "bstack": "./bin/bstack"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "bun build ./src/cli.ts --compile --outfile ./dist/bstack",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepublishOnly": "bun run type-check && bun test",
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2"
  }
}
