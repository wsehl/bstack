{
  "name": "bstack",
  "version": "1.0.3",
  "packageManager": "pnpm@11.5.1",
  "description": "Create native GitHub stacked pull requests from a linear series of commits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsehl/bstack.git"
  },
  "files": [
    "dist/bstack.js"
  ],
  "bin": {
    "bstack": "./dist/bstack.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run type-check && pnpm test",
    "start": "pnpm run build && node dist/bstack.js",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
